    { "id": "f1", "name": "Nur Süd", "kind": "filter", "inputs": "u1",
      "config": { "conditions": [{ "column": "Region", "op": "equals", "value": "Süd" }], "combine": "and" },
      "ui": { "x": 520, "y": 70 } }
  ],
  "result": "f1"
