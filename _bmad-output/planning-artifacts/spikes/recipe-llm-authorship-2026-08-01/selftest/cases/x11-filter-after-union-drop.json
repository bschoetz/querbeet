{
  "format": "querbeet/recipe@1",
  "name": "Filter auf eine Spalte, die die Union verworfen hat",
  "sources": [
    { "id": "b1", "name": "Bestellungen Januar", "file": "b1.csv", "columns": ["Bestellnr", "KundenNr", "Betrag", "Region"], "ui": { "x": 0, "y": 0 } },
    { "id": "b2", "name": "Bestellungen Februar", "file": "b2.csv", "columns": ["Bestellnr", "KundenNr", "Betrag"], "ui": { "x": 0, "y": 140 } }
  ],
  "steps": [
    { "id": "u1", "name": "Beide Monate", "kind": "union", "inputs": ["b1", "b2"],
      "config": { "mappings": [], "unmatched": "drop" },
